# --- Python ---
# Virtual environment folders
.venv/
venv/
env/
*/.venv/
*/venv/
*/env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- IDEs / Editors ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# --- Quant Project Specific ---
# Data files (historical data, etc.) - Should not be version controlled
data/
*.csv
*.hdf5
*.h5
*.parquet

# Log files
logs/
*.log

# Sensitive configuration files (API Keys, etc.) - NEVER commit these!
config/api_keys.yaml
config/secrets.yaml
*.env
.env*
!example.env  # Keep an example env file if you have one

# Test artifacts
.pytest_cache/
.coverage*
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# --- OS Specific files ---
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Other ---
# Temporary files
*.tmp
*.bak
*.swp